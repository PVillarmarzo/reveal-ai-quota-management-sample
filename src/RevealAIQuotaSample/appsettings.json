{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Reveal.Sdk.AI.Usage": "Warning"
    }
  },
  "AllowedHosts": "*",

  "RevealAI": {
    "Providers": {
      "openai": {
        "ApiKey": ""
      }
    },
    "DefaultProfile": "default",
    "Profiles": {
      "default": {
        "Provider": "openai",
        "Model": "gpt-4.1-mini",
        "MaxOutputTokens": 4096
      }
    },
    "Gate": {
      "IncludeSystemCalls": false
    }
  },

  "Quota": {
    "DailyTokenLimit": 100000,
    "EstimatedInputTokensPerCall": 16000,
    "DefaultOutputTokenReservation": 4096,
    "MissingUsagePolicy": "ChargeReservation",
    "TreatZeroTokenCountsAsMissing": true,
    "DatabasePath": "App_Data/quota.db",
    "EnableDevelopmentEndpoints": false
  },

  "Sample": {
    "UseDevelopmentUserHeader": false
  }
}
